<Window x:Class="FixPortal.FixAtdl.Wpf.Sample.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="FixPortal.FixAtdl.Wpf sample"
        Height="1060" Width="660"
        MinHeight="480" MinWidth="480"
        Background="{DynamicResource ApplicationBackgroundBrush}"
        WindowStartupLocation="CenterScreen">
    <!--
      Two deliberate choices about this window, neither of which the rendered panel knows about.

      Height 1060 is the rendered strategy's own measured height (765px) plus this window's chrome,
      so the form is readable without scrolling. The ScrollViewer stays, because a venue's real
      strategy can be any size, and the constructor clamps the height to the screen's work area.

      The Background is set because WPF's Fluent theme puts a Mica backdrop on the window, and Mica
      tints the window with the desktop wallpaper's dominant colour - which made this sample look
      like the library paints forms green when the wallpaper happened to be a green landscape. An
      opaque themed background shows the library rather than the wallpaper. Delete the attribute to
      get Mica back; the panel renders identically either way.
    -->

    <DockPanel Margin="12">

        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,10">
            <TextBlock Text="Participate" FontSize="18" FontWeight="SemiBold" />
            <TextBlock TextWrapping="Wrap" Margin="0,2,0,0"
                       Text="A synthetic FIXatdl 1.1 strategy, rendered by FixPortal.FixAtdl.Wpf. Everything below is generated from the strategy document - no layout code was written for it." />
            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                <TextBlock Text="Theme" VerticalAlignment="Center" Margin="0,0,6,0" />
                <ComboBox x:Name="ThemeSelector" Width="110" SelectionChanged="OnThemeChanged">
                    <ComboBoxItem Content="System" IsSelected="True" />
                    <ComboBoxItem Content="Light" />
                    <ComboBoxItem Content="Dark" />
                </ComboBox>
            </StackPanel>
        </StackPanel>

        <Grid DockPanel.Dock="Bottom" Margin="0,10,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,6">
                <Button x:Name="ReadBackButton" Content="Read back FIX values" Padding="10,4" Click="OnReadBack" />
                <TextBlock x:Name="StatusText" VerticalAlignment="Center" Margin="10,0,0,0" TextWrapping="Wrap" />
            </StackPanel>

            <TextBox x:Name="OutputText" Grid.Row="1" MaxHeight="150" MinLines="3"
                     FontFamily="Consolas" IsReadOnly="True" AcceptsReturn="True"
                     VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" />
        </Grid>

        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
            <ContentControl x:Name="PanelHost" HorizontalAlignment="Stretch" VerticalAlignment="Top" />
        </ScrollViewer>

    </DockPanel>
</Window>
